@{
    ViewData["Title"] = "User Dashboard";
    var username = Context.Session.GetString("Username") ?? "User";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>

        body {
            background: #f8f9fa;
        }


            .custom-navbar .nav-link:hover {
                color: #1e3a8a !important;
                color: #16a34a !important;
            }

        .navbar {
            background: linear-gradient(90deg, #0a1d37, #16a34a);
        }

        .welcome-card h2 {
            color: #1e3a8a;
        }

        .btn-primary {
            background-color: #1e3a8a;
            border-color: #1e3a8a;
        }

            .btn-primary:hover {
                background-color: #16a34a;
                border-color: #172554;
            }
    </style>

</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">Airline User</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link btn btn-outline-light btn-sm rounded-pill btn-custom" asp-controller="User" asp-action="Profile">Profile</a></li>
                    <li class="nav-item"><a class="nav-link btn btn-outline-light btn-sm rounded-pill btn-custom" asp-controller="User" asp-action="BookTicket">Book Ticket</a></li>
                    <li class="nav-item"><a class="nav-link btn btn-outline-light btn-sm rounded-pill btn-custom" asp-controller="User" asp-action="MyBookings">My Bookings</a></li>
                    <li class="nav-item"><a class="nav-link btn btn-outline-light btn-sm rounded-pill btn-custom" asp-controller="User" asp-action="Logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container d-flex justify-content-center">
        <div class="card welcome-card p-4 text-center col-md-6">
            <h2 class="mb-3">Welcome, @username!</h2>
            <p class="mb-3">Use the navigation buttons above to manage your profile and bookings efficiently.</p>
            <a asp-controller="User" asp-action="BookTicket" class="btn btn-primary btn-lg me-2">Book Ticket</a>
            <a asp-controller="User" asp-action="MyBookings" class="btn btn-secondary btn-lg">My Bookings</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
