@model IEnumerable<Air.Models.Airplane>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 text-primary">
        Available Flights
    </h2>
    <a asp-controller="User" asp-action="Dashboard" class="btn btn-primary">Back to Dashboard</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        No flights available.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var flight in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@flight.AirplaneName</h5>
                        <p class="card-text"><strong>From:</strong> @flight.StartingPoint</p>
                        <p class="card-text"><strong>To:</strong> @flight.Destination</p>
                        <p class="card-text"><strong>Departure:</strong> @flight.DepartureTime.ToString("dd MMM yyyy HH:mm")</p>
                        <p class="card-text"><strong>Ticket Price:</strong> $@flight.TicketPrice</p>
                        <a class="btn btn-primary w-100 mt-2" asp-action="SelectSeat" asp-route-flightId="@flight.Id">
                            Book Now
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    h2 {
        color: #0d6efd;
    }

    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
    }
</style>
